# Optional server-side OpenAI config.
# You can also paste an OpenAI key directly in the web Settings panel instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local database path. Default is fine.
GARMIN_AI_COACH_DB=data/garmin_ai_coach.sqlite3

# Optional: set this before exposing the app publicly or using a tunnel.
# When set, API calls must include: Authorization: Bearer <token>
# The web Settings panel has a Server API token field for this.
APP_SECRET_TOKEN=
