# Optional: the app works without this. Add it only if you want the Coach page to use OpenAI.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local database path. Default is fine.
GARMIN_AI_COACH_DB=data/garmin_ai_coach.sqlite3

# Optional: set this before deploying publicly.
# When set, API calls must include: Authorization: Bearer <token>
APP_SECRET_TOKEN=
